{
  "name": "ludy-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Crove - the open-source, AI-native Business OS for solo founders and SMEs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ludy/kernel-server --filter @ludy/extract --filter @ludy/app dev",
    "dev:web": "pnpm --filter @ludy/web dev",
    "build": "pnpm -r --filter=!@ludy/web build",
    "typecheck": "node tools/local-guard.mjs typecheck && pnpm -r --workspace-concurrency=1 typecheck && tsc --noEmit -p tools/tsconfig.json",
    "lint": "oxlint --deny-warnings apps/kernel apps/extract apps/media apps/app apps/desktop apps/extension apps/mobile packages modules e2e && node tools/ui-colors.mjs",
    "knip": "knip --no-progress",
    "depcruise": "depcruise --config .dependency-cruiser.mjs --output-type err-long apps packages modules e2e",
    "test": "node tools/local-guard.mjs test vitest run --project unit --",
    "test:db": "node tools/local-guard.mjs test:db vitest run --project db --",
    "test:e2e": "node tools/local-guard.mjs test:e2e pnpm --filter @ludy/e2e test --",
    "ai:conformance": "vitest run --project ai conformance",
    "mcp:conformance": "node tools/mcp-conformance/cli.mjs",
    "ai:eval": "vitest run --project ai extraction-eval --silent=false",
    "ai:eval:documents": "vitest run --project ai document-eval --silent=false",
    "ai:eval:transcribe": "vitest run --project ai transcribe-eval --silent=false",
    "ai:eval:coworkers": "vitest run --project ai coworker-eval --silent=false",
    "docs:check": "node tools/docs-check.mjs",
    "db:migrate": "pnpm --filter @ludy/db migrate",
    "db:types": "node tools/db-types.mjs",
    "migration:rebase": "node tools/migration-rebase.mjs",
    "db:vendor:pgboss": "pnpm --filter @ludy/kernel-server vendor:pgboss",
    "db:auth-grants": "pnpm --filter @ludy/kernel-server auth-grants",
    "alert:test": "node --env-file-if-exists=.env apps/kernel/src/main.ts prober --test-alert",
    "usage:report": "node --env-file-if-exists=.env apps/kernel/src/main.ts usage-report",
    "pilot:check": "node --env-file-if-exists=.env apps/kernel/src/main.ts pilot-check",
    "ops:kill-switch": "node --env-file-if-exists=.env tools/ops/kill-switch.mjs",
    "prepare": "node tools/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "kanel": "catalog:",
    "kanel-kysely": "catalog:",
    "knip": "catalog:",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
