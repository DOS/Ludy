{
  "name": "@crove/media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "crove-media: the media processing sandbox (ffmpeg, probe, normalize, split, repackage video). Bytes in, JSON out; no secrets, no egress.",
  "exports": {
    ".": "./src/server.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@crove/media-contract": "workspace:*",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  }
}
