#!/usr/bin/env bash
# A stand-in for docker in tools/test/deploy.test.ts. Records each call in $STUB_LOG and answers what deploy.sh
# asks. Settings (environment): STUB_SERVICES (compose services, space separated), STUB_RUNNING (services that
# `compose ps --status running` lists), STUB_WORKER_DOWN_DIGEST (the worker is down while this image runs),
# STUB_MIGRATE_EXIT, STUB_PULL_FAIL, STUB_BUILD_TIMES (space-separated digest=LUDY_BUILD_TIME pairs that `image
# inspect` answers; an image not listed carries none), STUB_ORPHAN_CONTAINERS (space-separated
# project:service=id entries returned for matching `docker ps` label filters), STUB_VOLUMES (space-separated
# volume names reported by `docker volume inspect`), STUB_PG_CLUSTER_IDS (space-separated vol=cluster_id pairs
# reported by `docker run ... -v <vol>:...` when matching PostgreSQL cluster identifiers).
#
# `compose run migrate` reads the env file the way the real step does (#3282): with a LUDY_CONTEXT_TOKEN_KEY it logs
# `context token key installed`, or `unchanged` when the same key was installed by an earlier run (kept in
# $STUB_LOG.installed); without one it logs nothing. It never prints the key. `compose exec` is the read-only count of
# plain idempotency rows: it answers STUB_PLAIN_ROWS (default 0), or fails with STUB_PSQL_FAIL as its error text.
set -euo pipefail

if [ "${1:-}" = login ]; then
  # The password arrives on stdin, never as an argument.
  cat >"$STUB_LOG.password"
  printf 'login DOCKER_CONFIG=%s %s\n' "${DOCKER_CONFIG:-}" "${*:2}" >>"$STUB_LOG"
  exit 0
fi
if [ "${1:-}" = pull ]; then
  printf 'pull %s DOCKER_CONFIG=%s\n' "${*: -1}" "${DOCKER_CONFIG:-}" >>"$STUB_LOG"
  [ -z "${STUB_PULL_FAIL:-}" ] || exit 1
  exit 0
fi
if [ "${1:-}" = image ] && [ "${2:-}" = inspect ]; then
  printf 'image inspect %s\n' "${*: -1}" >>"$STUB_LOG"
  for pair in ${STUB_BUILD_TIMES:-}; do
    case "${*: -1}" in *"@sha256:${pair%%=*}") printf 'PATH=/usr/bin\nLUDY_BUILD_TIME=%s\n' "${pair#*=}" ;; esac
  done
  exit 0
fi
if [ "${1:-}" = ps ]; then
  [ -z "${STUB_PS_FAIL:-}" ] || exit 1
  proj='' svc='' status_filter='' wdir_filter='' id_filter=''
  shift
  while (($# > 0)); do
    case "$1" in
      --filter)
        case "$2" in
          label=com.docker.compose.project=*) proj="${2#label=com.docker.compose.project=}" ;;
          label=com.docker.compose.service=*) svc="${2#label=com.docker.compose.service=}" ;;
          label=com.docker.compose.project.working_dir=*) wdir_filter="${2#label=com.docker.compose.project.working_dir=}" ;;
          status=*) status_filter="${2#status=}" ;;
          id=*) id_filter="${2#id=}" ;;
        esac
        shift 2
        ;;
      *) shift ;;
    esac
  done
  if [ -n "$wdir_filter" ]; then
    for item in ${STUB_WORKDIR_CONTAINERS:-}; do
      IFS='|' read -r iw isvc icid <<<"$item"
      [ "$iw" = "$wdir_filter" ] || continue
      if [ -n "$svc" ] && [ "$isvc" != "$svc" ]; then continue; fi
      printf '%s\n' "$icid"
    done
    exit 0
  fi
  if [ -n "$id_filter" ]; then
    for item in ${STUB_RUNNING_CONTAINERS:-}; do
      if [ "$item" = "$id_filter" ]; then printf '%s\n' "$item"; exit 0; fi
    done
    for item in ${STUB_WORKDIR_CONTAINERS:-}; do
      IFS='|' read -r _ _ icid <<<"$item"
      if [ "$icid" = "$id_filter" ]; then printf '%s\n' "$icid"; exit 0; fi
    done
    exit 0
  fi
  if [ "$status_filter" = running ]; then
    for item in ${STUB_RUNNING_CONTAINERS:-}; do printf '%s\n' "$item"; done
    exit 0
  fi
  printf 'docker ps --filter label=com.docker.compose.project=%s --filter label=com.docker.compose.service=%s\n' "$proj" "$svc" >>"$STUB_LOG.orphans"
  for item in ${STUB_ORPHAN_CONTAINERS:-}; do
    key="${item%%=*}"
    val="${item#*=}"
    cid="${val%%:*}"
    if [ "$val" != "$cid" ]; then oneoff="${val#*:}"; else oneoff='False'; fi
    if [ "$key" = "${proj}:${svc}" ]; then
      printf '%s %s\n' "$cid" "$oneoff"
    fi
  done
  exit 0
fi
if [ "${1:-}" = inspect ]; then
  [ -z "${STUB_INSPECT_FAIL:-}" ] || exit 1
  shift
  fmt='' target=''
  while (($# > 0)); do
    case "$1" in
      --format) fmt="$2"; shift 2 ;;
      *) target="$1"; shift ;;
    esac
  done
  for item in ${STUB_INSPECT_MOUNTS:-}; do
    IFS='|' read -r icid iproj imtype imname imsrc <<<"$item"
    [ "$icid" = "$target" ] || continue
    case "$fmt" in
      *Labels*)
        printf '%s\n' "$iproj"
        exit 0
        ;;
      *.Mounts*)
        printf '%s|%s|%s\n' "$imtype" "$imname" "$imsrc"
        ;;
    esac
  done
  exit 0
fi
if [ "${1:-}" = stop ]; then
  printf 'docker %s\n' "$*" >>"$STUB_LOG"
  printf 'docker %s\n' "$*" >>"$STUB_LOG.orphans"
  [ -z "${STUB_ORPHAN_STOP_FAIL:-}" ] || { echo 'stop: stub failure' >&2; exit 1; }
  exit 0
fi
if [ "${1:-}" = rm ]; then
  printf 'docker %s\n' "$*" >>"$STUB_LOG"
  printf 'docker %s\n' "$*" >>"$STUB_LOG.orphans"
  [ -z "${STUB_ORPHAN_RM_FAIL:-}" ] || { echo 'rm: stub failure' >&2; exit 1; }
  exit 0
fi
if [ "${1:-}" = volume ] && [ "${2:-}" = inspect ]; then
  for v in ${STUB_VOLUMES:-}; do
    if [ "$v" = "${3:-}" ]; then exit 0; fi
  done
  exit 1
fi
if [ "${1:-}" = run ]; then
  printf 'docker %s\n' "$*" >>"$STUB_LOG.volumes"
  raw_args="$*"
  vols=()
  shift
  while (($# > 0)); do
    case "$1" in
      -v)
        if (($# >= 2)); then
          vols+=("${2%%:*}")
          shift 2
        else
          shift
        fi
        ;;
      *) shift ;;
    esac
  done
  ((${#vols[@]} >= 1)) || exit 1
  stub_cluster_id() {
    local target="$1" pair
    for pair in ${STUB_PG_CLUSTER_IDS:-}; do
      if [ "${pair%%=*}" = "$target" ] && [ -n "${pair#*=}" ]; then
        printf '%s' "${pair#*=}"
        return 0
      fi
    done
    return 1
  }
  stub_is_populated() {
    local target="$1" m
    if stub_cluster_id "$target" >/dev/null; then return 0; fi
    for m in ${STUB_POPULATED_MOUNTS:-}; do
      if [ "$m" = "$target" ]; then return 0; fi
    done
    return 1
  }
  if [[ "$raw_args" == *pg_control* ]]; then
    ((${#vols[@]} >= 2)) || exit 1
    if ! stub_is_populated "${vols[0]}"; then exit 0; fi
    for m in ${STUB_PG_PID_MOUNTS:-} ${STUB_PG_STALE_MOUNTS:-}; do
      if [ "$m" = "${vols[0]}" ] || [ "$m" = "${vols[1]}" ]; then exit 1; fi
    done
    c0="$(stub_cluster_id "${vols[0]}" || true)"
    c1="$(stub_cluster_id "${vols[1]}" || true)"
    if [ -n "$c0" ] && [ "$c0" = "$c1" ]; then exit 0; fi
    exit 1
  fi
  if ! stub_is_populated "${vols[0]}"; then exit 0; fi
  ((${#vols[@]} >= 2)) || exit 1
  if ! stub_is_populated "${vols[1]}"; then exit 1; fi
  if [[ "$raw_args" == *lstatSync* ]] && [[ "$raw_args" == *readExact* ]]; then
    local_m=''
    for local_m in ${STUB_PARTIAL_MOUNTS:-}; do
      if [ "$local_m" = "${vols[1]}" ]; then exit 1; fi
    done
  fi
  exit 0
fi
[ "${1:-}" = compose ] || {
  echo "stub docker: unexpected $*" >&2
  exit 99
}
shift
if [ "${1:-}" = version ]; then
  echo '2.30.0'
  exit 0
fi

# Skip the global options deploy.sh passes before the subcommand.
files=()
envfile=''
proj_override=''
while (($# > 0)); do
  case "$1" in
    -p | --project-name)
      proj_override="$2"
      shift 2
      ;;
    --env-file)
      envfile="$2"
      shift 2
      ;;
    --project-directory) shift 2 ;;
    -f)
      files+=("$2")
      shift 2
      ;;
    *) break ;;
  esac
done
sub="$1"
shift
args="$*"
printf 'compose %s %s\n' "$sub" "$args" >>"$STUB_LOG"
# The compose files of each active call (`config` without flags is read-only YAML resolution before/after activate).
if [ "$sub" != config ] || [ -n "$args" ]; then
  printf '%s\n' "${files[*]}" >>"$STUB_LOG.files"
fi

emit_stub_compose_config() {
  local p="$1" app_svc='ludy' db_mount_yaml='' files_vol="${1}_files" keys_vol="${1}_keys" archive_vol="${1}_archive" db_vol="${1}_db-data"
  if [ "$p" = crove ]; then app_svc='crove'; fi
  case " ${STUB_SERVICES:-} " in *" worker "*) app_svc='worker' ;; esac
  if [ "$p" != crove ] && [ -n "${STUB_NEW_DB_BIND:-}" ]; then
    db_mount_yaml="      - type: bind\n        source: ${STUB_NEW_DB_BIND}\n        target: /var/lib/postgresql/data"
  else
    db_mount_yaml="      - type: volume\n        source: db-data\n        target: /var/lib/postgresql/data"
  fi
  if [ "$p" != crove ] && [ -n "${STUB_NEW_DB_VOLUME:-${STUB_DB_VOLUME:-}}" ]; then
    db_vol="${STUB_NEW_DB_VOLUME:-${STUB_DB_VOLUME:-}}"
  fi
  if [ "$p" != crove ] && [ -n "${STUB_NEW_FILES_VOLUME:-}" ]; then files_vol="$STUB_NEW_FILES_VOLUME"; fi
  if [ "$p" != crove ] && [ -n "${STUB_NEW_KEYS_VOLUME:-}" ]; then keys_vol="$STUB_NEW_KEYS_VOLUME"; fi
  if [ "$p" != crove ] && [ -n "${STUB_NEW_ARCHIVE_VOLUME:-}" ]; then archive_vol="$STUB_NEW_ARCHIVE_VOLUME"; fi
  printf 'name: %s\nservices:\n  db:\n    volumes:\n%b\n  %s:\n    volumes:\n      - type: volume\n        source: files\n        target: /data/files\n      - type: volume\n        source: keys\n        target: /data/keys\n      - type: volume\n        source: archive\n        target: /data/archive\nvolumes:\n  db-data:\n    name: %s\n  files:\n    name: %s\n  keys:\n    name: %s\n  archive:\n    name: %s\n' \
    "$p" "$db_mount_yaml" "$app_svc" "$db_vol" "$files_vol" "$keys_vol" "$archive_vol"
}

case "$sub" in
  config)
    # STUB_CONFIG_FAIL_IF_ENV_HAS: the compose files do not load while the env file holds this text (#2704).
    if [ "${1:-}" = --quiet ] && [ -n "${STUB_CONFIG_FAIL_IF_ENV_HAS:-}" ] && grep -q -F -- "$STUB_CONFIG_FAIL_IF_ENV_HAS" "$envfile"; then exit 1; fi
    if [ "${1:-}" = --services ]; then
      for s in ${STUB_SERVICES:-db migrate auth auth-grants ludy-extract mailpit ludy}; do echo "$s"; done
    elif [ -z "${1:-}" ]; then
      if [ -n "${STUB_PREV_CONFIG_FAIL:-}" ]; then exit 1; fi
      if [ -n "${STUB_PREV_CONFIG_REQUIRE_ENV:-}" ] && [ -f "$STUB_DEPLOY_DIR/docker-compose.override.yml" ] && grep -q "${STUB_PREV_IMAGE_MATCH:-__none__}" "$STUB_DEPLOY_DIR/docker-compose.override.yml"; then
        req_var="$STUB_PREV_CONFIG_REQUIRE_ENV"
        if [ -z "${!req_var:-}" ]; then exit 1; fi
      fi
      if [ "${STUB_COMPOSE_PROJECT:-}" = __empty__ ]; then
        exit 0
      elif [ -n "${STUB_COMPOSE_PROJECT:-}" ]; then
        emit_stub_compose_config "$STUB_COMPOSE_PROJECT"
      else
        proj="${proj_override:-${COMPOSE_PROJECT_NAME:-}}"
        if [ -z "$proj" ] && [ -n "$envfile" ] && [ -f "$envfile" ]; then
          proj="$(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?COMPOSE_PROJECT_NAME[[:space:]]*[=:][[:space:]]*(.*)$/\2/p' "$envfile" | tail -n 1)"
          proj="${proj%$'\r'}"
        fi
        if [ -z "$proj" ]; then
          for cf in "${files[@]}"; do
            [ -f "$cf" ] || continue
            cname="$(sed -n -E 's/^name:[[:space:]]*(.*)$/\1/p' "$cf" | head -n 1)"
            cname="${cname%$'\r'}"
            if [ -n "$cname" ]; then proj="$cname"; fi
          done
        fi
        emit_stub_compose_config "${proj:-ludy}"
      fi
    fi
    ;;
  port) echo '127.0.0.1:18080' ;;
  run)
    case "$args" in
      *migrate*)
        # An environment variable of the caller must not reach the step: the env file is the one source of the key.
        { [ -z "${LUDY_CONTEXT_TOKEN_KEY+x}" ]; } || echo seen >"$STUB_LOG.envvar"
        key="$(sed -n 's/^LUDY_CONTEXT_TOKEN_KEY=//p' "$envfile" | tail -n 1)"
        if [ -n "$key" ]; then
          if [ -f "$STUB_LOG.installed" ] && [ "$(cat "$STUB_LOG.installed")" = "$key" ]; then echo 'context token key unchanged'; else
            printf '%s\n' "$key" >"$STUB_LOG.installed"
            echo 'context token key installed'
          fi
        fi
        exit "${STUB_MIGRATE_EXIT:-0}"
        ;;
    esac
    ;;
  exec)
    if [ -n "${STUB_PSQL_FAIL:-}" ]; then
      echo "$STUB_PSQL_FAIL" >&2
      exit 1
    fi
    echo "${STUB_PLAIN_ROWS-0}"
    ;;
  ps)
    # The worker is down while the image in STUB_WORKER_DOWN_DIGEST is the active release.
    if [ -n "${STUB_WORKER_DOWN_DIGEST:-}" ] && grep -q "$STUB_WORKER_DOWN_DIGEST" "$STUB_DEPLOY_DIR/docker-compose.override.yml"; then
      echo api
    else
      for s in ${STUB_RUNNING:-worker}; do echo "$s"; done
    fi
    ;;
  up) ;;
  logs) [ -z "${STUB_WORKER_LOG:-}" ] || echo "$STUB_WORKER_LOG" ;;
  rm) [ -z "${STUB_RM_FAIL:-}" ] || { echo 'rm: stub failure' >&2; exit 1; } ;;
  *)
    echo "stub docker compose: unexpected $sub" >&2
    exit 99
    ;;
esac
