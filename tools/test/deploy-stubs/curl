#!/usr/bin/env bash
# A stand-in for curl in tools/test/deploy.test.ts: answers the kernel's endpoints. The release that runs is the
# image in $STUB_DEPLOY_DIR/docker-compose.override.yml; when it holds $STUB_BAD_DIGEST, or STUB_READYZ_FAIL is
# set, /readyz answers 503. STUB_NO_BUNDLE (always) and STUB_NO_BUNDLE_DIGEST (while that image runs) serve a
# sign-in page without its script.
#
# /version (#892) reports the first 12 hex digits of the running image's digest as its build ("dev" when nothing
# runs), "stale" while $STUB_STALE_DIGEST runs (an old container still answers), and a missing migration with
# STUB_MIGRATION_MISSING.
#
# The account step of the smoke test (#690): every command line goes to $STUB_LOG.argv, so a test can check that no
# secret is on one; the sign-in body read from stdin goes to $STUB_LOG.signin, the uploaded file to
# $STUB_LOG.upload, an RPC body to $STUB_LOG.rpc. STUB_SIGNIN_FAIL refuses the sign-in, STUB_FILE_STATUS sets the
# uploaded file's status (default proposed), STUB_REJECT_FAIL fails the rejection. A remote identity provider (#2704): its
# keys at .../.well-known/jwks.json (STUB_JWKS_FAIL: 404, STUB_JWKS_EMPTY, STUB_JWKS_OCT) and its https .../auth/v1/health (STUB_IDP_HEALTH_FAIL: 404, or
# STUB_IDP_REDIRECT: 301). STUB_IDP_HEALTH_HTML: the Auth URL is this API's address by mistake (its page answers). STUB_NO_PROXY: this deployment has no /auth/v1 proxy (404 anywhere but at https://idp.*). /api/config reports authUrl as <base>/auth/v1, or STUB_AUTH_URL, and modules from CROVE_MODULES in $STUB_DEPLOY_DIR/.env (with kernel), or STUB_CONFIG_MODULES.
set -euo pipefail

printf '%s\n' "$*" >>"$STUB_LOG.argv"
out='' url='' headers='' data='' form='' wout='' fail=0
while (($# > 0)); do
  case "$1" in
    --output)
      out="$2"
      shift 2
      ;;
    --fail)
      fail=1
      shift
      ;;
    --max-time | --request | --proto | --proto-redir)
      shift 2
      ;;
    --write-out)
      wout="$2"
      shift 2
      ;;
    --header)
      if [[ "$2" == @* ]]; then headers="$(cat "${2#@}")"; fi
      shift 2
      ;;
    --data-binary)
      if [ "$2" = @- ]; then data="$(cat)"; else data="$2"; fi
      shift 2
      ;;
    --form)
      form="$2"
      shift 2
      ;;
    http://* | https://*)
      url="$1"
      shift
      ;;
    *) shift ;;
  esac
done
printf 'curl %s\n' "$url" >>"$STUB_LOG"

running="$(cat "$STUB_DEPLOY_DIR/docker-compose.override.yml" 2>/dev/null || true)"
status=200 body=''
case "$url" in
  */healthz) body='{"ok":true}' ;;
  */readyz)
    if [ -n "${STUB_READYZ_FAIL:-}" ] || { [ -n "${STUB_BAD_DIGEST:-}" ] && [[ "$running" == *"$STUB_BAD_DIGEST"* ]]; }; then
      status=503 body='{"ready":false,"reason":"schema"}'
    else
      body='{"ready":true}'
    fi
    ;;
  */version)
    build=dev
    if [[ "$running" =~ /crove@sha256:([0-9a-f]{12}) ]]; then build="${BASH_REMATCH[1]}"; fi
    if [ -n "${STUB_VERSION_BUILD:-}" ]; then build="$STUB_VERSION_BUILD"; fi
    if [ -n "${STUB_STALE_DIGEST:-}" ] && [[ "$running" == *"$STUB_STALE_DIGEST"* ]]; then build=stale; fi
    missing='[]'
    if [ -n "${STUB_MIGRATION_MISSING:-}" ]; then missing='["20990101000000_crove_kernel_next.sql"]'; fi
    body="{\"build\":\"$build\",\"migrationsMissing\":$missing}"
    ;;
  */api/config)
    # What the running API reports: the PUBLIC_AUTH_URL and CROVE_MODULES of the host's env file when present (#2704, #3531),
    # else the bundled proxy and empty modules; STUB_AUTH_URL and STUB_CONFIG_MODULES override them.
    configured="$(sed -n 's/^PUBLIC_AUTH_URL=//p' "$STUB_DEPLOY_DIR/.env" 2>/dev/null | tail -n 1 | tr -d '\r')"
    modules_json='[]'
    if [ -n "${STUB_CONFIG_MODULES+x}" ]; then
      if [[ "$STUB_CONFIG_MODULES" == \[* ]]; then
        modules_json="$STUB_CONFIG_MODULES"
      elif [ -n "$STUB_CONFIG_MODULES" ]; then
        modules_json="[\"${STUB_CONFIG_MODULES//,/\",\"}\"]"
      fi
    else
      configured_modules="$(sed -n -E 's/\r$//; s/^[[:space:]]*(export[[:space:]]+)?LUDY_MODULES[[:space:]]*[=:][[:space:]]*(.*)$/\2/p' "$STUB_DEPLOY_DIR/.env" 2>/dev/null | tail -n 1)"
      if [ -z "$configured_modules" ]; then
        configured_modules="$(sed -n -E 's/\r$//; s/^[[:space:]]*(export[[:space:]]+)?CROVE_MODULES[[:space:]]*[=:][[:space:]]*(.*)$/\2/p' "$STUB_DEPLOY_DIR/.env" 2>/dev/null | tail -n 1)"
      fi
      if [ -n "$configured_modules" ]; then
        modules_list='kernel'
        IFS=',' read -r -a stub_mods <<<"$configured_modules"
        for m in "${stub_mods[@]}"; do
          m="${m// /}"
          [ -n "$m" ] && [ "$m" != kernel ] && [[ ",$modules_list," != *",$m,"* ]] && modules_list+=",$m"
        done
        modules_json="[\"${modules_list//,/\",\"}\"]"
      fi
    fi
    body="{\"authUrl\":\"${STUB_AUTH_URL:-${configured:-${url%/api/config}/auth/v1}}\",\"modules\":$modules_json}"
    ;;
  */auth/v1/health)
    # A remote identity provider's address (https://...) answers unless STUB_IDP_HEALTH_FAIL; the key travels in a header file.
    # The kernel with no proxy: a 404, or (STUB_NO_PROXY=html) the app's own page, which answers 200 to any GET.
    if [ "${STUB_NO_PROXY:-}" = html ] && [[ "$url" != https://idp.* ]]; then body='<div id="root"></div>'
    elif [ -n "${STUB_NO_PROXY:-}" ] && [[ "$url" != https://idp.* ]]; then status=404 body='{}'
    elif [ -n "${STUB_IDP_HEALTH_HTML:-}" ] && [[ "$url" == https://* ]]; then body='<div id="root"></div>'
    elif [ -n "${STUB_IDP_REDIRECT:-}" ] && [[ "$url" == https://* ]]; then status=301 body=''
    elif [ -n "${STUB_IDP_HEALTH_FAIL:-}" ] && [[ "$url" == https://* ]]; then status=404 body='{}'
    else body='{"name":"GoTrue"}'; fi
    ;;
  */.well-known/jwks.json)
    # A key of an asymmetric family by default; STUB_JWKS_EMPTY: no key; STUB_JWKS_OCT: a shared key only.
    if [ -n "${STUB_JWKS_FAIL:-}" ]; then status=404 body='{}'
    elif [ -n "${STUB_JWKS_EMPTY:-}" ]; then body='{"keys":[]}'
    elif [ -n "${STUB_JWKS_OCT:-}" ]; then body='{"keys":[{"kty":"oct","kid":"k1"}]}'
    else body='{"keys":[{"kty":"EC","crv":"P-256","alg":"ES256","kid":"k1"}]}'; fi
    ;;
  */login)
    if [ -n "${STUB_APP_HTML+x}" ]; then
      body="$STUB_APP_HTML"
    elif [ -n "${STUB_NO_BUNDLE:-}" ] || { [ -n "${STUB_NO_BUNDLE_DIGEST:-}" ] && [[ "$running" == *"$STUB_NO_BUNDLE_DIGEST"* ]]; }; then
      body='<div id="root"></div>'
    else
      body='<div id="root"></div><script type="module" crossorigin src="/assets/index-abc123.js"></script>'
    fi
    ;;
  */assets/theme-boot.js) body='document.documentElement.dataset.theme="light";' ;;
  */assets/index-abc123.js)
    if [ -n "${STUB_APP_SWITCH_ON:-}" ] && [ -n "${STUB_APP_BUNDLE_NEXT:-}" ]; then
      hits=0
      if [ -f "$STUB_LOG.bundle_hits" ]; then hits="$(cat "$STUB_LOG.bundle_hits")"; fi
      hits=$((hits + 1))
      printf '%s\n' "$hits" >"$STUB_LOG.bundle_hits"
      if ((hits >= STUB_APP_SWITCH_ON)); then body="$STUB_APP_BUNDLE_NEXT"; else body="${STUB_APP_BUNDLE_JS:-console.log(1)}"; fi
    else
      body="${STUB_APP_BUNDLE_JS:-console.log(1)}"
    fi
    ;;
  */assets/router-xyz.js)
    if [ -n "${STUB_APP_ROUTER_JS:-}" ]; then body="$STUB_APP_ROUTER_JS"; else status=404; fi
    ;;
  */auth/v1/token\?grant_type=password)
    printf '%s' "$data" >"$STUB_LOG.signin"
    if [ -n "${STUB_SIGNIN_FAIL:-}" ]; then status=400 body='{"error":"invalid_grant"}'; else body='{"access_token":"stub-access-token","token_type":"bearer"}'; fi
    ;;
  */api/files | */api/rpc/*)
    if [[ "$headers" != *'authorization: Bearer stub-access-token'* ]] || { [[ "$headers" != *'x-ludy-org: crove-smoke'* ]] && [[ "$headers" != *'x-crove-org: crove-smoke'* ]]; }; then
      status=401 body='{"code":"UNAUTHENTICATED"}'
    elif [[ "$url" == */api/files ]]; then
      file="${form#file=@}"
      cp "${file%%;*}" "$STUB_LOG.upload"
      body='{"files":[{"fileId":"file-1","duplicate":false}]}'
    elif [[ "$url" == */api/rpc/files/recent ]]; then
      case "${STUB_FILE_STATUS:-proposed}" in
        proposed) mine='{"id":"file-1","status":"proposed","proposalId":"proposal-1","error":null}' ;;
        failed) mine='{"id":"file-1","status":"failed","proposalId":null,"error":"UNREADABLE"}' ;;
        proposed-no-id) mine='{"id":"file-1","status":"proposed","proposalId":null,"error":"SOME_ERROR"}' ;;
        *) mine="{\"id\":\"file-1\",\"status\":\"$STUB_FILE_STATUS\",\"proposalId\":null,\"error\":null}" ;;
      esac
      body="{\"json\":[{\"id\":\"file-0\",\"status\":\"proposed\",\"proposalId\":\"proposal-0\",\"error\":null},$mine]}"
    elif [[ "$url" == */api/rpc/inbox/reject ]]; then
      printf '%s' "$data" >"$STUB_LOG.rpc"
      if [ -n "${STUB_REJECT_FAIL:-}" ]; then status=500 body='{"code":"INTERNAL"}'; else body='{"json":{"ok":true}}'; fi
    else
      status=404
    fi
    ;;
  *) status=404 ;;
esac

if [ -n "$out" ]; then printf '%s' "$body" >"$out"; else printf '%s' "$body"; fi
# --write-out '%{http_code}': the status follows the body, as curl prints it.
if [ "$wout" = '%{http_code}' ]; then printf '%s' "$status"; fi
# curl --fail exits 22 on an HTTP error; without it the exit status is 0 (the caller reads the code it asked for with --write-out).
if ((status >= 400 && fail)); then exit 22; fi
exit 0
